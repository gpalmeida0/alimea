# Alimea environment
# The app runs out of the box with an in-memory demo store. The variables below
# switch on the production backend and optional integrations.

# --- Supabase (production data backend) --------------------------------------
# Set both to use Supabase instead of the in-memory store. Apply every file in
# supabase/migrations (in order) first: `supabase db push`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — used by the daily reminder cron (cross-tenant) and by the
# studio admin tool (`npm run admin`) that creates accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app. Used by `npm run admin` to build invite and
# password-reset links (e.g. https://app.alimea.pt).
NEXT_PUBLIC_SITE_URL=

# --- In-memory backend --------------------------------------------------------
# Signs the demo session cookie. Set a long random value in any shared deployment.
SESSION_SECRET=

# --- Clinic time zone ------------------------------------------------------------
# Used for appointment times, SMS text and "today". Defaults to Europe/Lisbon.
NEXT_PUBLIC_APP_TIME_ZONE=Europe/Lisbon

# --- AI assistant (optional) -------------------------------------------------------
# Translate / improve text. Without a key the buttons explain it is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- SMS reminders (optional, Twilio) ---------------------------------------------
# Without all three, reminders run in preview mode (in-app outbox only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Daily reminder cron (/api/cron/reminders, see vercel.json) -------------------
# Required in production: Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
