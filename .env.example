# Alimea environment
# The app runs out-of-the-box with an in-memory data store. The variables below
# are only needed to switch to the Supabase production backend.

# Supabase (optional — production data backend). Set both to switch from the
# in-memory store to the real database (schema in supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — only needed for the cross-tenant daily reminder cron.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (optional — powers the AI assistant: translate / summarise / improve text)
OPENAI_API_KEY=

# SMS reminders (optional — Twilio). Without these, reminders run in preview mode
# (logged to the in-app outbox instead of being really sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Protects the daily reminder cron endpoint (/api/cron/reminders).
# When set, the scheduler must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
