{
  "name": "alimea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "admin": "tsx --tsconfig tsconfig.json scripts/admin.ts",
    "backup:storage": "tsx --tsconfig tsconfig.json scripts/backup-storage.ts",
    "pdf:sample": "tsx --tsconfig tsconfig.json scripts/test-pdf.ts",
    "test": "tsx --tsconfig tsconfig.json --test tests/*.test.ts",
    "test:coverage": "tsx --tsconfig tsconfig.json --test --experimental-test-coverage --test-coverage-include='src/lib/**' --test-coverage-exclude='src/lib/data/**' --test-coverage-exclude='src/lib/supabase/**' --test-coverage-exclude='src/lib/ai/**' --test-coverage-exclude='src/lib/files.ts' --test-coverage-exclude='src/lib/auth/session.ts' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "openai": "^7.32.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
